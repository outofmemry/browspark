{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Browspark",
  "description": "Local MCP server for simultaneous Chrome, Brave, Firefox, and Zen browser sessions.",
  "colors": {
    "primary": "#1f8a5f",
    "light": "#4dab9a",
    "dark": "#166b49"
  },
  "logo": {
    "light": "/images/logo.png",
    "dark": "/images/logo.png"
  },
  "favicon": "/images/logo.png",
  "appearance": {
    "default": "system"
  },
