{
  "name": "browspark-mcp",
  "version": "0.6.1",
  "license": "MIT",
  "type": "module",
  "files": [
    "companion/src",
    "shared"
  ],
  "bin": {
    "browspark-mcp": "companion/src/index.ts"
  },
  "scripts": {
    "build": "bun scripts/extension.ts",
    "typecheck": "tsc --noEmit -p companion && tsc --noEmit -p extension",
    "test": "bun test --timeout 120000",
    "start": "bun companion/src/index.ts",
    "package": "bun scripts/extension.ts --package",
    "capabilities": "bun companion/test/capabilities.ts",
    "docs:tools": "bun companion/test/docs.ts",
    "test:e2e": "E2E=1 bun test --timeout 120000",
    "test:firefox": "FIREFOX_E2E=1 bun test companion/test/firefox.e2e.test.ts --timeout 120000",
    "test:multi-browser": "MULTI_BROWSER_E2E=1 bun test companion/test/multi-developer.e2e.test.ts --timeout 240000",
    "compile": "bun build --compile companion/src/index.ts --outfile dist/browspark",
    "release": "bun pm whoami && bun publish --access public && for a in aliases/*; do (cd $a && ([ \"$(bun -p 'require(\"./package.json\").version')\" = \"$npm_package_version\" ] || bun pm version $npm_package_version --no-git-tag-version) && bun publish --access public); done"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "ws": "^8.18.0",
    "zod": "^4.6.2",
    "lighthouse": "^12.8.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
