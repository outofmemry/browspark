{
  "manifest_version": 3,
  "name": "Browspark",
  "version": "0.6.1",
  "description": "Share existing Firefox or Zen tabs with your local MCP companion, alongside other connected browsers.",
  "permissions": ["tabs", "storage", "alarms", "downloads"],
  "optional_permissions": ["userScripts"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*" },
  "background": { "scripts": ["dist/background.js"] },
  "action": { "default_title": "Open Browspark", "default_icon": "assets/logo.png" },
  "icons": { "16": "assets/logo.png", "32": "assets/logo.png", "48": "assets/logo.png", "128": "assets/logo.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "browspark@krishm.dev",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent", "websiteActivity"]
      }
    }
  }
}
